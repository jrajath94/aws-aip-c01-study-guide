flowchart LR
  S["Start"] --> IM["InvokeModel<br/>draft answer"]
  IM --> PR["Parse response<br/>+ extract fields"]
  PR --> CC{"Confidence<br/>>= threshold?"}
  CC -->|low: retry| IM
  CC -->|high| HA["Human approval<br/>wait for task token"]
  HA -->|approved| PB["Publish result"]
  HA -->|rejected| EJ["End: rejected"]
  style CC fill:#161616,stroke:#f0b429,color:#ececec
  style PB fill:#161616,stroke:#3fb96b,color:#ececec
