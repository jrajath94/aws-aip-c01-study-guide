flowchart TB
  Q["New question"] --> LK["Semantic cache lookup<br/>similarity > 0.95?"]
  LK -->|hit| HIT["Return cached answer<br/>~0 cost, instant"]
  LK -->|miss| M["Call Bedrock model"]
  M --> ST["Store Q + A<br/>in cache"]
  ST --> A["Answer"]
  HIT --> A
  style LK fill:#161616,stroke:#f0b429,color:#ececec
  style HIT fill:#161616,stroke:#3fb96b,color:#ececec
